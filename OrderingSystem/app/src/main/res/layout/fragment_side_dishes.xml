<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="請選擇副餐 (可複選)"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="自由搭配您喜愛的副餐與點心"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/cbSideDish1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="美式黃金薯條 ($45)"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/cbSideDish2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="香酥雞塊 (6塊) ($55)"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/cbSideDish3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="鮮蔬沙拉 ($40)"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/cbSideDish4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="葡式蛋塔 ($35)"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/cbSideDish5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="洋蔥圈 ($45)"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
